PORT=3106
# Where finished music lands on the NAS. Isolated test dir by default;
# repoint to /mnt/pi-nas/plex/music once you're happy and want Navidrome/Plex to see it.
NAS_MOUNT=/mnt/pi-nas/zotify
# Spotify rate-limits aggressively — keep this at 1.
MAX_CONCURRENT=1
STALL_TIMEOUT_MS=600000
# Folder/file layout on the NAS. Tokens: {album_artist} {artist} {album} {year}
# {track_number} (zero-padded) {song_name}. Use {artist} instead of {album_artist}
# if you'd rather group by track-artist (splits compilations/features).
OUTPUT_TEMPLATE={album_artist}/{album} ({year})/{track_number}. {song_name}

# Read-only Lidarr lookup so beets tags to the release Lidarr already monitors.
# LAN address, not a container name — zotify-wrapper and lidarr aren't on one network.
# Leave LIDARR_URL empty to disable and let beets pick releases on its own.
LIDARR_URL=http://192.168.1.2:8686
LIDARR_API_KEY=
